# Banco MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=GHCE

# auto = best.pt especializado quando existir; senão detector aberto incluído
DETECTION_MODE=auto
YOLO_WEIGHTS=models/best.pt
OPEN_VOCAB_WEIGHTS=models/yolov8s-worldv2.pt
OBJECT_CATALOG=configuration/object_catalog.json
CLIP_WEIGHTS=weights/clip/ViT-B-32.pt
YOLO_CONF=0.38
YOLO_IOU=0.45
TEMPORAL_HITS=2
TEMPORAL_WINDOW=3
IMMEDIATE_CONF=0.78
TEMPORAL_IOU=0.25
CAMERA_DEVICE=0

# Perfil conservador: mais precisão e rejeição de desconhecidos; pode reduzir recall/FPS
CLIP_VERIFY=true
CLIP_MIN_SCORE=0.24
CLIP_MIN_MARGIN=0.050
CLIP_REJECT_MARGIN=0.040
CLIP_REJECT_MIN_SCORE=0.20
CLIP_IMMEDIATE_MARGIN=0.120
CLIP_CROSS_GROUP_MARGIN=0.100
CLIP_MIN_VIEW_AGREEMENT=2
CLIP_MAX_DETECTIONS=12
CLIP_FAIL_CLOSED=true

# Proteções da API
MAX_REQUEST_BYTES=12000000
MAX_IMAGE_PIXELS=20000000
# Em produção, use a origem exata do frontend, por exemplo:
# CORS_ORIGIN=https://ghce.suaempresa.com.br
CORS_ORIGIN=*

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
